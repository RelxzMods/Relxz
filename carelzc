-- FORMAT RARITY
local function formatRarity(num)
    if not num or num == 0 then return "?" end
    if num >= 1e33 then return string.format("%.2fDc", num / 1e33)
    elseif num >= 1e30 then return string.format("%.2fNo", num / 1e30)
    elseif num >= 1e27 then return string.format("%.2fOc", num / 1e27)
    elseif num >= 1e24 then return string.format("%.2fSp", num / 1e24)
    elseif num >= 1e21 then return string.format("%.2fSx", num / 1e21)
    elseif num >= 1e18 then return string.format("%.2fQi", num / 1e18)
    elseif num >= 1e15 then return string.format("%.2fQ", num / 1e15)
    elseif num >= 1e12 then return string.format("%.2fT", num / 1e12)
    elseif num >= 1e9 then return string.format("%.2fB", num / 1e9)
    elseif num >= 1e6 then return string.format("%.2fM", num / 1e6)
    elseif num >= 1e3 then return string.format("%.2fK", num / 1e3)
    else return tostring(math.floor(num)) end
end

local function getEggRarity(eggModel)
    local handle = eggModel:FindFirstChild("Handle")
    if not handle then return 0, "?" end
    local eggLuck = handle:FindFirstChild("EggLuck")
    if not eggLuck then return 0, "?" end
    for _, desc in ipairs(eggLuck:GetDescendants()) do
        if desc:IsA("TextLabel") then
            local text = desc.Text
            local num = text:match("([%d%.]+)%s*[Qq][iI]")
            if num then return (tonumber(num) or 0) * 1e18, text end
            num = text:match("([%d%.]+)%s*[Ss][xX]")
            if num then return (tonumber(num) or 0) * 1e21, text end
            num = text:match("([%d%.]+)%s*[Ss][pP]")
            if num then return (tonumber(num) or 0) * 1e24, text end
            num = text:match("([%d%.]+)%s*[Oo][cC]")
            if num then return (tonumber(num) or 0) * 1e27, text end
            num = text:match("([%d%.]+)%s*[Nn][oO]")
            if num then return (tonumber(num) or 0) * 1e30, text end
            num = text:match("([%d%.]+)%s*[Dd][cC]")
            if num then return (tonumber(num) or 0) * 1e33, text end
            local n, s = text:match("([%d%.]+)%s*([QqTtBbMmKk])")
            if n then
                local val = tonumber(n) or 0
                local up = s:upper()
                if up == "Q" then val = val * 1e15
                elseif up == "T" then val = val * 1e12
                elseif up == "B" then val = val * 1e9
                elseif up == "M" then val = val * 1e6
                elseif up == "K" then val = val * 1e3
                end
                return val, text
            end
            local plain = text:match("(%d+)")
            if plain and #plain >= 10 then
                return tonumber(plain) or 0, text
            end
        end
    end
    return 0, "?"
end

-- ESP CHAMS
local highlightCache = {}
local nameCache = {}

local function clearEggESP()
    for _, h in pairs(highlightCache) do
        if h then h:Destroy() end
    end
    highlightCache = {}
    for _, n in pairs(nameCache) do
        if n then n:Remove() end
    end
    nameCache = {}
end

local function isEggValid(egg)
    if not egg or not egg.Parent then return false end
    local ancestor = egg.Parent
    while ancestor do
        if ancestor == workspace then break end
        if game.Players:FindFirstChild(ancestor.Name) then return false end
        ancestor = ancestor.Parent
    end
    return true
end

local function updateEggESP()
    if not Config.ESPEggMahal and not Config.ESPAllEgg then
        if next(highlightCache) or next(nameCache) then clearEggESP() end
        return
    end
    local validEggs = {}
    for _, egg in ipairs(workspace:GetDescendants()) do
        local n = egg.Name:lower()
        local isEgg = false
        if egg:IsA("Model") and (n:find("egg") or egg:FindFirstChild("EggBase")) then
            isEgg = true
        end
        if isEgg and isEggValid(egg) then
            validEggs[egg] = true
            local rarity = getEggRarity(egg)
            local show = false
            if Config.ESPAllEgg then show = true
            elseif Config.ESPEggMahal and rarity >= Config.MinRarity then show = true end

            if show then
                if not highlightCache[egg] or highlightCache[egg].Parent ~= egg then
                    if highlightCache[egg] then highlightCache[egg]:Destroy() end
                    local hl = Instance.new("Highlight")
                    hl.Name = "RZ_EggHL"
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.FillColor = Color3.fromRGB(255, 40, 40)
                    hl.OutlineColor = Color3.fromRGB(255, 100, 100)
                    hl.FillTransparency = 0.6
                    hl.OutlineTransparency = 0
                    hl.Parent = egg
                    highlightCache[egg] = hl
                end
                local part = egg:FindFirstChild("EggBase") or egg:FindFirstChild("Handle") or egg:FindFirstChildWhichIsA("BasePart")
                if part then
                    if not nameCache[egg] then
                        local nt = Drawing.new("Text")
                        nt.Size = 14
                        nt.Center = true
                        nt.Outline = true
                        nt.OutlineColor = Color3.fromRGB(0, 0, 0)
                        nameCache[egg] = nt
                    end
                    local nt = nameCache[egg]
                    local pos, on = Camera:WorldToViewportPoint(part.Position + Vector3.new(0, 2, 0))
                    if on then
                        nt.Text = egg.Name .. " [" .. formatRarity(rarity) .. "]"
                        nt.Position = Vector2.new(pos.X, pos.Y)
                        nt.Color = Color3.fromRGB(255, 255, 255)
                        nt.Visible = true
                    else
                        nt.Visible = false
                    end
                end
            else
                if highlightCache[egg] then highlightCache[egg].Enabled = false end
                if nameCache[egg] then nameCache[egg].Visible = false end
            end
        end
    end
    for egg, hl in pairs(highlightCache) do
        if not validEggs[egg] or not isEggValid(egg) then
            if hl then hl:Destroy() end
            highlightCache[egg] = nil
        end
    end
    for egg, nt in pairs(nameCache) do
        if not validEggs[egg] or not isEggValid(egg) then
            if nt then nt:Remove() end
            nameCache[egg] = nil
        end
    end
end

